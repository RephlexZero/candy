 SG_ SrcAddrOfCtrlDevForEngCtrl : 40|8@1+ (1,0) [0|255] "" Transmission
 SG_ EngStarterMode : 48|4@1+ (1,0) [0|15] "" Cab

BO_ 2565866752 ETC2: 8 Transmission
 SG_ TransSelectedGear : 0|8@1+ (1,-125) [-125|125] "" Engine,Cab
 SG_ TransActualGearRatio : 8|16@1+ (0.001,0) [0|64.255] "" Engine
 SG_ TransCurrentGear : 24|8@1+ (1,-125) [-125|125] "" Engine,Cab

BO_ 2566843904 ET1: 8 Engine
 SG_ EngCoolantTemp : 0|8@1+ (1,-40) [-40|210] "degC" Cab
 SG_ EngFuelTemp1 : 8|8@1+ (1,-40) [-40|210] "degC" Cab
 SG_ EngOilTemp1 : 16|16@1+ (0.03125,-273) [-273|1734.96875] "degC" Cab

BO_ 2566844160 EFL_P1: 8 Engine
 SG_ EngFuelDeliveryPress : 0|8@1+ (4,0) [0|1000] "kPa" Cab
 SG_ EngOilLevel : 16|8@1+ (0.4,0) [0|100] "%" Cab
 SG_ EngOilPress : 24|8@1+ (4,0) [0|1000] "kPa" Cab
 SG_ EngCoolantLevel : 56|8@1+ (0.4,0) [0|100] "%" Cab

BO_ 2566844672 CCVS1: 8 Brakes
 SG_ TwoSpeedAxleSwitch : 0|2@1+ (1,0) [0|3] "" Engine
 SG_ ParkingBrakeSwitch : 2|2@1+ (1,0) [0|3] "" Engine,Cab
 SG_ WheelBasedVehicleSpeed : 8|16@1+ (0.00390625,0) [0|250.996] "km/h" Engine,Transmission,Cab
 SG_ CruiseCtrlActive : 24|2@1+ (1,0) [0|3] "" Engine,Cab
 SG_ BrakeSwitch : 28|2@1+ (1,0) [0|3] "" Engine,Transmission

BO_ 2566844928 LFE1: 8 Engine
 SG_ EngFuelRate : 0|16@1+ (0.05,0) [0|3212.75] "L/h" Cab
 SG_ EngInstantaneousFuelEconomy : 16|16@1+ (0.001953125,0) [0|125.5] "km/L" Cab
 SG_ EngThrottleValve1Pos : 48|8@1+ (0.4,0) [0|100] "%" Cab



CM_ "Subset of SAE J1939-71 parameter groups for a heavy-duty engine.";
CM_ BO_ 2364539904 "Electronic Engine Controller 1, PGN 61444.";
CM_ SG_ 2364539904 EngSpeed "SPN 190: actual engine speed.";
CM_ BO_ 2566844672 "Cruise Control / Vehicle Speed 1, PGN 65265.";
CM_ SG_ 2566844672 WheelBasedVehicleSpeed "SPN 84.";
